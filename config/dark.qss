QWidget {
    background-color: #0b1220;
    color: #e5e7eb;
    font-family: "Segoe UI";
    font-size: 10.5pt;
}
QMainWindow, QDialog { background-color: #07101d; }
QFrame#panel, QGroupBox {
    background-color: #111827;
    border: 1px solid #263244;
    border-radius: 8px;
}
QGroupBox {
    margin-top: 10px;
    padding-top: 12px;
    font-weight: 600;
}
QPushButton {
    background-color: #162033;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px 10px;
}
QPushButton:hover { background-color: #1f2a40; }
QPushButton:pressed { background-color: #0f172a; }
QLineEdit, QComboBox {
    background-color: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 7px;
    selection-background-color: #315a93;
}
QListWidget, QTableWidget, QTreeWidget {
    background-color: #0d1626;
    alternate-background-color: #111b2c;
    border: 1px solid #263244;
    gridline-color: #263244;
}
QHeaderView::section {
    background-color: #162033;
    color: #e5e7eb;
    padding: 6px;
    border: 0;
    border-right: 1px solid #263244;
    border-bottom: 1px solid #263244;
}
QTabWidget::pane { border: 1px solid #263244; }
QTabBar::tab {
    background: #111827;
    padding: 8px 14px;
    border: 1px solid #263244;
}
QTabBar::tab:selected { background: #1c2b42; }
QScrollBar:vertical { background: #0f172a; width: 12px; }
QScrollBar::handle:vertical { background: #334155; border-radius: 5px; min-height: 24px; }
QLabel#title { font-size: 18pt; font-weight: 700; }
QLabel#subtitle { color: #94a3b8; }
QLabel#metricValue { font-size: 14pt; font-weight: 700; }
QToolTip { background: #111827; color: #fff; border: 1px solid #475569; }
